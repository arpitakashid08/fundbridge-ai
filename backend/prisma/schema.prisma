generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  password     String
  company      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications Application[]
  profile      BusinessProfile?
  documents    Document[]
}

model BusinessProfile {
  id                 String  @id @default(cuid())
  userId             String  @unique
  industry           String?
  location           String?
  businessStage      String?
  revenue            Float?
  fundingRequirement Float?
  employees          Int?
  description        String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FundingOpportunity {
  id           String        @id @default(cuid())
  title        String
  type         String
  provider     String
  description  String
  location     String?
  minAmount    Float?
  maxAmount    Float?
  deadline     DateTime?
  website      String?
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id            String             @id @default(cuid())
  userId        String
  opportunityId String
  status        String             @default("draft")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  opportunity   FundingOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id         String   @id @default(cuid())
  userId     String
  name       String
  type       String
  status     String   @default("pending")
  fileUrl    String?
  uploadedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
