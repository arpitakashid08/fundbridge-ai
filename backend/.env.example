# Runtime
NODE_ENV=development
PORT=5050

# PostgreSQL (use a managed, non-local database URL in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Use a long, random value in production. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated frontend origins allowed to call this API.
FRONTEND_ORIGIN=http://localhost:5173

# Files are stored here. In production this must be a mounted persistent volume.
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_PATH=/uploads

# Remote Ollama-compatible AI endpoint. Keep this server-side only.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
AI_REQUEST_TIMEOUT_MS=15000
